                  "pm.test('В ответе есть автор', function () {",
                  "    pm.expect(json).to.have.property('author');",
                  "});",
                  "",
                  "pm.test('В ответе есть список книг', function () {",
                  "    pm.expect(json.books).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Проверить несуществующего автора",
          "request": {
