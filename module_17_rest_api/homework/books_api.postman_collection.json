              "raw": "{\n  \"first_name\": \"Test\",\n  \"last_name\": \"Author {{$timestamp}}\",\n  \"middle_name\": \"Middle\"\n}"
            },
            "url": "{{base_url}}/api/authors"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('Статус ответа — 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Автор получил id', function () {",
                  "    pm.expect(json).to.have.property('id');",
                  "});",
                  "",
                  "pm.collectionVariables.set('created_author_id', json.id);"
                ]
              }
