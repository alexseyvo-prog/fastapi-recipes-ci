{
    "info": {
        "_postman_id": "hotel-api-v2",
        "name": "Hotel API v2",
        "description": "Улучшенная версия API с RESTful названиями и best practices",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": null,
    "variable": [
        {
            "key": "url",
            "value": "http://localhost:5000",
            "type": "string"
        },
        {
            "key": "api_version",
            "value": "v1",
            "type": "string"
        },
        {
            "key": "check_in",
            "value": "20210308",
            "type": "string"
        },
        {
            "key": "check_out",
            "value": "20210311",
            "type": "string"
        },
        {
            "key": "guests_count",
            "value": "2",
            "type": "string"
        },
        {
            "key": "room_id",
            "value": "1",
            "type": "string"
        },
        {
            "key": "booking_id",
            "value": "1",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Rooms",
            "item": [
                {
                    "name": "Create Room",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201.\", () => {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "if (pm.response.code === 201) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.environment.set('room_id', jsonData.room_id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"floor\": 1,\n    \"beds_count\": 1,\n    \"max_guests\": 2,\n    \"price_per_night\": 1000\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{url}}/api/{{api_version}}/rooms",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "api",
                                "{{api_version}}",
                                "rooms"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Get All Rooms",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200.\", () => {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has rooms array.\", () => {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.rooms).to.be.an('array');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{url}}/api/{{api_version}}/rooms?check_in={{check_in}}&check_out={{check_out}}&guests_count={{guests_count}}",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "api",
                                "{{api_version}}",
                                "rooms"
                            ],
                            "query": [
                                {
                                    "key": "check_in",
                                    "value": "{{check_in}}"
                                },
                                {
                                    "key": "check_out",
                                    "value": "{{check_out}}"
                                },
                                {
                                    "key": "guests_count",
                                    "value": "{{guests_count}}"
                                }
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Get Room by ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200.\", () => {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has room_id.\", () => {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.room_id).to.exist;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{url}}/api/{{api_version}}/rooms/{{room_id}}",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "api",
                                "{{api_version}}",
                                "rooms",
                                "{{room_id}}"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Bookings",
            "item": [
                {
                    "name": "Create Booking",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201.\", () => {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "if (pm.response.code === 201) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.environment.set('booking_id', jsonData.booking_id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"room_id\": {{room_id}},\n    \"check_in\": {{check_in}},\n    \"check_out\": {{check_out}},\n    \"guest_first_name\": \"John\",\n    \"guest_last_name\": \"Smith\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{url}}/api/{{api_version}}/bookings",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "api",
                                "{{api_version}}",
                                "bookings"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Get Booking by ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200.\", () => {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{url}}/api/{{api_version}}/bookings/{{booking_id}}",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "api",
                                "{{api_version}}",
                                "bookings",
                                "{{booking_id}}"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Cancel Booking",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200.\", () => {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{url}}/api/{{api_version}}/bookings/{{booking_id}}",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "api",
                                "{{api_version}}",
                                "bookings",
                                "{{booking_id}}"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        }
    ]
}